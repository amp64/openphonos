<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
			 xmlns:ic="using:FluentIcons.Avalonia.MarkupExtensions"
             xmlns:view="clr-namespace:PhonosAvalon.Views;assembly=PhonosAvalon"
			 xmlns:vm="clr-namespace:PhonosAvalon.ViewModels"
			 x:DataType="vm:IVolume"
			 x:Name="Page"
             x:Class="PhonosAvalon.Views.VolumeView">

	<!-- Ref https://docs.avaloniaui.net/docs/reference/controls/buttons/togglebutton -->	
	<UserControl.Styles>
		<Style Selector="ToggleButton ContentControl.audio-on">
			<Setter Property="IsVisible" Value="False"/>
		</Style>
		<Style Selector="ToggleButton:checked ContentControl.audio-on">
			<Setter Property="IsVisible" Value="True"/>
		</Style>
		<Style Selector="ToggleButton ContentControl.audio-mute">
			<Setter Property="IsVisible" Value="True"/>
		</Style>
		<Style Selector="ToggleButton:checked ContentControl.audio-mute">
			<Setter Property="IsVisible" Value="False"/>
		</Style>
	
		<Style Selector="Button.UpDown">
			<Setter Property="Foreground" Value="{DynamicResource ButtonForeground}"/>
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="Width" Value="{DynamicResource IconButtonSize}"/>
			<Setter Property="Height" Value="{DynamicResource IconButtonSize}"/>
			<Setter Property="HorizontalContentAlignment" Value="Center"/>
			<Setter Property="VerticalContentAlignment" Value="Center"/>
			<Setter Property="FontSize" Value="22"/>
			<!-- these are important for Material theme -->
			<Setter Property="Padding" Value="0"/>
			<Setter Property="Margin" Value="4"/>
		</Style>
	
	</UserControl.Styles>

	<Grid Margin="0">
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="{DynamicResource IconButtonGrid}"/>
			<ColumnDefinition Width="{DynamicResource IconButtonGrid}"/>
			<ColumnDefinition Width="*"/>
			<ColumnDefinition Width="{DynamicResource IconButtonGrid}"/>
		</Grid.ColumnDefinitions>


		<StackPanel Orientation="Horizontal"
			Grid.Column="2"
			VerticalAlignment="Top" HorizontalAlignment="Left"
			IsVisible="{Binding ElementName=Page, Path=Title, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
			<TextBlock Text="{Binding ElementName=Page, Path=Title}"/>
			<view:BatteryView DataContext="{Binding ElementName=Page, Path=Battery}" VerticalAlignment="Top"/>
		</StackPanel>

		<ToggleButton
			Margin="0,0,4,0"
			IsChecked="{Binding Muted, Mode=TwoWay}"
			Classes="IconStyle"
			HotKey="VolumeMute"
			ToolTip.Tip="Mute">
			<Panel>
				<ContentControl Classes="audio-off">
					<ic:SymbolIcon Symbol="Speaker1"/>
				</ContentControl>
				<ContentControl Classes="audio-on">
					<ic:SymbolIcon Symbol="SpeakerMute"/>
				</ContentControl>
			</Panel>
		</ToggleButton>

		<Button
			Grid.Column="1"
			Content="-"
			Classes="UpDown"
			Click="VolumeDown_Click"
			Margin="0,0,8,0"
			HotKey="VolumeDown"
			IsVisible="{Binding !Fixed}"
			/>
		
		<Slider
			Grid.Column="2"
			VerticalAlignment="Center"
			TickPlacement="None"
			Value="{Binding Volume}"
			Maximum="100"
			x:Name="PART_Slider"
			IsEnabled="{Binding !Fixed}"
			ValueChanged="OnValueChanged"
			>
			<Slider.Resources>
				<x:Double x:Key="SliderHorizontalThumbWidth">16</x:Double>
				<x:Double x:Key="SliderHorizontalThumbHeight">16</x:Double>
			</Slider.Resources>
		</Slider>
		<TextBlock
			Grid.Column="2"
			VerticalAlignment="Center"
			HorizontalAlignment="Center"
			Text="Fixed Volume"
			IsVisible="{Binding Fixed}"
			Foreground="LightGray"
			/>
		<Button
			Grid.Column="3"
			Content="+"
			Classes="UpDown"
			Click="VolumeUp_Click"
			Margin="4,0,2,0"
			HotKey="VolumeUp"
			IsVisible="{Binding !Fixed}"
			/>
		<TextBlock
			Grid.Column="2"
			VerticalAlignment="Top"
			HorizontalAlignment="Right"
			Text="{Binding Volume}"
			FontSize="10"
			Margin="0,4,0,0"
			>
			<TextBlock.IsVisible>
				<MultiBinding Converter="{x:Static BoolConverters.And}">
					<Binding Path="ShowNumber" ElementName="Page"/>
					<Binding Path="Fixed" Converter="{x:Static BoolConverters.Not}"/>
				</MultiBinding>
			</TextBlock.IsVisible>
		
		</TextBlock>
			
	</Grid>
</UserControl>

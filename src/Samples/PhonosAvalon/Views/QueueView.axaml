<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:ic="using:FluentIcons.Avalonia.MarkupExtensions"
             xmlns:asyncImageLoader="clr-namespace:AsyncImageLoader;assembly=AsyncImageLoader.Avalonia"
			 xmlns:OpenPhonos="clr-namespace:OpenPhonos.Sonos;assembly=OpenPhonos.Sonos"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
			 xmlns:vm="clr-namespace:PhonosAvalon.ViewModels"
			 xmlns:local="clr-namespace:PhonosAvalon.Views;assembly=PhonosAvalon"
			 x:DataType="vm:GroupViewModel"
			 x:CompileBindings="True"
             x:Class="PhonosAvalon.Views.QueueView">
	<UserControl.Styles>
		<Style Selector="ListBoxItem">
		  <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}" />
		</Style>			
	</UserControl.Styles>

	<UserControl.Resources>
		<DataTemplate x:Key="MusicItemListTemplate" DataType="{x:Type OpenPhonos:QueueMusicItem}">
			<Grid Margin="-6,-3,-6,-6">
				<!-- Delete button, initially hidden -->
				<Button Background="Red" Padding="0" Margin="2" Width="32"
					CornerRadius="0"
					HorizontalContentAlignment="Center"
					VerticalContentAlignment="Center"
					HorizontalAlignment="Right"
					VerticalAlignment="Stretch"
					Click="DeleteQueue_Click"
					IsVisible="False"
					Foreground="White">
					<Button.Content>
						<ic:SymbolIcon Symbol="Delete"/>
					</Button.Content>
				</Button>

				<!-- Swipeable content -->
				<Border
				PointerPressed="OnPointerPressed"
				PointerMoved="OnPointerMoved"
				PointerReleased="OnPointerReleased"
				BorderThickness="0"
				Padding="2,2,6,2"
				Margin="0"
				Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
				>
					<Border.RenderTransform>
						<TranslateTransform/>
					</Border.RenderTransform>
					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="32"/>
							<ColumnDefinition Width="*"/>
							<ColumnDefinition Width="32"/>
						</Grid.ColumnDefinitions>
						<Grid.RowDefinitions>
							<RowDefinition Height="32"/>
						</Grid.RowDefinitions>

						<StackPanel Orientation="Vertical" Grid.Column="1" Margin="4,0,0,0" VerticalAlignment="Center">
							<TextBlock Text="{Binding Title}" HorizontalAlignment="Left"/>
							<TextBlock Text="{Binding Subtitle}" HorizontalAlignment="Left" IsVisible="{Binding Subtitle, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
						</StackPanel>
						<Grid Grid.RowSpan="1" Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="-4,0,0,0">
							<Button Content="{ic:SymbolIcon Symbol=Play}"
									Classes="IconStyle"
									Command="{Binding $parent[ListBox].((vm:GroupViewModel)DataContext).Queue.PlayPauseCommand}"
									CommandParameter="{Binding}"
									IsVisible="{Binding PlayVisible}"/>
							<Button Content="{ic:SymbolIcon Symbol=Pause}"
									Classes="IconStyle"
									Command="{Binding $parent[ListBox].((vm:GroupViewModel)DataContext).Queue.PlayPauseCommand}"
									CommandParameter="{Binding}"
									IsVisible="{Binding PauseVisible}"/>
						</Grid>
						<Image Grid.Column="0" Grid.RowSpan="2" Margin="2"
							   asyncImageLoader:ImageLoader.Source="{Binding ArtUriAsync^}"
							   Stretch="UniformToFill"
							   />
					</Grid>
				</Border>
			</Grid>
		</DataTemplate>
	
		<local:StringSameConverter x:Key="StringSameConverter" DefaultValue="albumArtUri"/>
	</UserControl.Resources>

	<Design.DataContext>
		<vm:FakeGroupViewModel />
	</Design.DataContext>

	<Grid >
		<Grid.RowDefinitions>
			<RowDefinition Height="{DynamicResource IconButtonGrid}"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>
		<Grid ColumnDefinitions="Auto,*,Auto,Auto">
			<Button Classes="BackButton" Tapped="BackButton_Tapped" ToolTip.Tip="Back"/>
			<TextBlock Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" TextWrapping="NoWrap" Margin="0,0,0,0">
				<Run Text="{Binding Queue.Heading}"/>
				<Run Text="{Binding Summary}" FontWeight="Bold"/>
				<Run Text="{Binding Queue.QueueSize, StringFormat={}{0} songs}"/>
			</TextBlock>
			<Button Grid.Column="2" Content="{ic:SymbolIcon Symbol=Delete}" Classes="IconStyleClear" ToolTip.Tip="Empty Queue" HorizontalAlignment="Center"
					Command="{Binding Queue.PreClearCommand}"/>
			<Button Grid.Column="3" Content="{ic:SymbolIcon Symbol=Save}" Classes="IconStyleClear" ToolTip.Tip="Save as Playlist" HorizontalAlignment="Center"
					Command="{Binding Queue.SaveQueueCommand}"
					IsDefault="True"
					/>
		</Grid>
		
		<Grid Grid.Row="1" MinHeight="{DynamicResource IconButtonSize}"
			  IsVisible="{Binding Queue.EditState, Converter={StaticResource StringSameConverter}, ConverterParameter=PreClear}">
			<StackPanel Orientation="Horizontal">
				<TextBlock Text="Are you sure you want to clear the queue?" VerticalAlignment="Center"/>
				<Button Content="Yes" Command="{Binding Queue.PostClearCommand}"/>
			</StackPanel>
		</Grid>
		
		<Grid Grid.Row="1" MinHeight="{DynamicResource IconButtonSize}"
			  IsVisible="{Binding Queue.EditState, Converter={StaticResource StringSameConverter}, ConverterParameter=Error}">
			<TextBlock Text="{Binding Queue.StateMessage}" MaxLines="2" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center"/>
		</Grid>

		<Grid Grid.Row="1" MinHeight="{DynamicResource IconButtonSize}"
			  IsVisible="{Binding Queue.EditState, Converter={StaticResource StringSameConverter}, ConverterParameter=Message}">
			<TextBlock Text="{Binding Queue.StateMessage}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
		</Grid>

		<Grid Grid.Row="1" ColumnDefinitions="Auto,*" Margin="50,0,50,0" 
			  IsVisible="{Binding Queue.EditState, Converter={StaticResource StringSameConverter}, ConverterParameter=PreSave}">
			<TextBlock Text="Name:" VerticalAlignment="Center" Margin="0,0,8,0"/>
			<ComboBox x:Name="PList" Grid.Column="1" HorizontalAlignment="Stretch" IsTextSearchEnabled="True" 
					  ItemsSource="{Binding Queue.Playlists}"
					  SelectedIndex="{Binding Queue.PlaylistIndex}"
					  SelectionChanged="ComboBox_SelectionChanged">
				<ComboBox.ItemTemplate>
					<DataTemplate>
						<TextBlock Text="{Binding Title}" TextWrapping="NoWrap"/>
					</DataTemplate>
				</ComboBox.ItemTemplate>
			</ComboBox>
		</Grid>

		<Grid Grid.Row="1" ColumnDefinitions="Auto,*" Margin="50,0,50,0"
			  IsVisible="{Binding Queue.EditState, Converter={StaticResource StringSameConverter}, ConverterParameter=PreSaveNew}">
			<TextBlock Text="Name:" VerticalAlignment="Center" Margin="0,0,8,0"/>
			<TextBox Grid.Column="1" Text="{Binding Queue.NewPlaylistName, Mode=TwoWay}" Watermark="New Playlist Name"/>
		</Grid>

		<ListBox x:Name="QueueListBox" Grid.Row="2"
				 Background="{DynamicResource SystemControlHighlightListLowBrush}"
				 ItemsSource="{Binding Queue.Items}"
				 HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
				 SelectionMode="Single" 
				 ItemTemplate="{StaticResource MusicItemListTemplate}">
		</ListBox>
	</Grid>
</UserControl>
